# Copy to .env. Defaults match docker-compose.yml.

# --- Core ---
APP_URL=http://localhost:3000
# ≥ 32 chars; encrypts OAuth tokens and signs demo sessions (openssl rand -base64 48)
APP_SECRET=change-me-change-me-change-me-change-me
# Enables the no-login demo account (seeded by `pnpm db:seed`)
DEMO_MODE=true

# --- Postgres (pgvector) ---
POSTGRES_USER=concorra
POSTGRES_PASSWORD=concorra
POSTGRES_DB=concorra
DATABASE_URL=postgresql://concorra:concorra@localhost:5432/concorra

# --- Object storage (RustFS, S3 API) ---
S3_ENDPOINT=http://localhost:9000
# Public URL used in presigned download links (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=concorra
S3_SECRET_KEY=concorra-secret
S3_BUCKET=concorra
S3_FORCE_PATH_STYLE=true

# --- Gemini (AI) ---
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-2.5-pro / gemini-2.5-flash / gemini-embedding-001)
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_CLASSIFY=
GEMINI_MODEL_DRAFT=
GEMINI_MODEL_VERIFY=
GEMINI_MODEL_OCR=
GEMINI_MODEL_EMBED=

# --- WorkOS AuthKit ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# ≥ 32 chars
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_WEBHOOK_SECRET=
# Role slugs configured in the WorkOS dashboard
WORKOS_ROLE_OWNER=admin
WORKOS_ROLE_MEMBER=member

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Concorra <no-reply@example.com>

# --- AbacatePay (v2, dev-mode key for the demo) ---
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Product ids created by `pnpm billing:products`
ABACATEPAY_PRODUCT_PRO=
ABACATEPAY_PRODUCT_BUSINESS=

# --- Calendars (OAuth apps) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Worker ---
PANDOC_BIN=pandoc
WORKER_CONCURRENCY=2
